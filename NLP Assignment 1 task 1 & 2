      "source": [
        "# Reload our modified models.py\n",
        "import importlib\n",
        "import models\n",
        "importlib.reload(models)\n",
        "\n",
        "# Load data\n",
        "from sentiment_data import read_sentiment_examples\n",
        "\n",
        "train_exs = read_sentiment_examples(\"data/train.txt\")\n",
        "dev_exs = read_sentiment_examples(\"data/dev.txt\")\n",
        "\n",
        "# Run the three learning-rate schedules\n",
        "results = {}\n",
        "\n",
        "for schedule in [\"constant\", \"decay\", \"1/t\"]:\n",
        "    feat_extractor = models.UnigramFeatureExtractor(models.Indexer())\n",
        "\n",
        "    model, history = models.train_logistic_regression_schedule(\n",
        "        train_exs,\n",
        "        dev_exs,\n",
        "        feat_extractor,\n",
        "        schedule=schedule\n",
        "    )\n",
        "\n",
        "    results[schedule] = history\n",
        "\n",
        "    print(\n",
        "        f\"{schedule:>8}: \"\n",
        "        f\"train = {history['train_acc'][-1]:.4f}, \"\n",
        "        f\"dev = {history['dev_acc'][-1]:.4f}\"\n",
        "    )\n",
        "\n",
        "# Plot 1: Dataset log likelihood vs. training iterations\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "plt.figure()\n",
        "for schedule, h in results.items():\n",
        "    plt.plot(h[\"iteration\"], h[\"log_likelihood\"], label=schedule)\n",
        "\n",
        "plt.xlabel(\"Training iterations\")\n",
        "plt.ylabel(\"Dataset log likelihood\")\n",
        "plt.title(\"Training Objective vs. Training Iterations\")\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "# Plot 2: Development accuracy vs. training iterations\n",
        "plt.figure()\n",
        "for schedule, h in results.items():\n",
        "    plt.plot(h[\"iteration\"], h[\"dev_acc\"], label=schedule)\n",
        "\n",
        "plt.xlabel(\"Training iterations\")\n",
        "plt.ylabel(\"Development accuracy\")\n",
        "plt.title(\"Development Accuracy vs. Training Iterations\")\n",
        "plt.legend()\n",
        "plt.show()"
